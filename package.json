{
  "name": "audio-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "bench": "tsx scripts/bench.ts",
    "synth": "python3 scripts/make-synthetic.py",
    "build:server": "esbuild server/main.ts server/hash-password.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist-server --out-extension:.js=.mjs --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\"",
    "hash-password": "tsx server/hash-password.ts"
  },
  "dependencies": {
    "browser-id3-writer": "^6.4.0",
    "mpg123-decoder": "^1.0.3",
    "read-excel-file": "^9.3.12",
    "wasm-media-encoders": "^0.7.0",
    "wavesurfer.js": "^7.12.12",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^4.0.5"
  }
}
